/* Copy to secrets.h and fill in. secrets.h is gitignored.
 *
 * Most of this is optional. With nothing but the server URL and the provisioning salt,
 * a board is set up from a phone and asks the server for its own identity — see
 * provisioning.h. The rest are escape hatches for development.
 *
 * The device key and id are no longer needed: a board asks the server for its own
 * identity and shows a claim code to enter on the dashboard. Define them to opt out of
 * that and pin a board to credentials you already have.
 */
#ifndef SECRETS_H
#define SECRETS_H

/* Leave both undefined to set the network up from a phone with Espressif's
 * "ESP BLE Provisioning" app, which is how a receiver is meant to be configured: the
 * network is picked from a scan rather than typed, so it cannot be mistyped, and moving
 * a board to a different network needs no rebuild. This project lost a flash cycle to an
 * SSID whose final character was a lowercase l where the network used an uppercase I.
 *
 * Defining them opts out of provisioning entirely and compiles the credentials in, which
 * is useful on a board being developed against and a poor idea anywhere else. */
/* #define CIELOTRACK_WIFI_SSID     "your-network" */
/* #define CIELOTRACK_WIFI_PASSWORD "your-password" */
/* The server this receiver reports to. It talks only to this address, so set it to a
 * server you run. Required: the URL is concatenated into request paths at compile time,
 * so a build with it undefined does not compile.
 *
 * Left as a placeholder on purpose. It used to default to a live server, and a board
 * flashed with the default quietly registered against that server and sat polling it for
 * a claim that was never coming -- a stranger's receiver phoning home to someone else's
 * fleet. A placeholder host fails to resolve instead, so an unconfigured board reaches
 * nothing rather than the wrong place, and you notice and set your own. */
#define CIELOTRACK_SERVER_URL    "https://your-server.example"
/* Shared across the fleet, and the actual secret behind provisioning. Each board's
 * pairing code is derived from this and its own MAC, so one build serves every board
 * while the code still differs per board — deriving it from the MAC alone would be no
 * protection at all, since the MAC is in the advertisement the phone reads. Change it
 * and every board must be re-provisioned. */
#define CIELOTRACK_PROV_SALT     "change-me-once-per-fleet"

/* #define CIELOTRACK_DEVICE_KEY    "paste-the-device-api-key" */
/* Both optional, and both opt out of claiming when defined — the heartbeat endpoint is
 * per-device and the server checks the id matches the key, so they come from the same
 * claimed device row and must be given together or not at all. */
/* #define CIELOTRACK_DEVICE_ID     "paste-the-device-uuid" */

/* Which radio this board is. One image, two roles, because two radios' work on one
 * radio is exactly what the second board exists to avoid — so they are mutually
 * exclusive rather than both switched on.
 *
 *   0  BLE: extended scanning, reporting as each contact decodes.
 *   1  Wi-Fi: promiscuous on the Remote ID channel, uploading in batches between
 *      listening windows, because the access point here is on a different channel and
 *      one radio cannot be on both.
 *
 * Each board needs its own device key: two boards sharing one identity makes every
 * comparison between them meaningless.
 */
#define CIELOTRACK_ROLE_WIFI 0

/* Optional, and it did not work on the network it was written for. Read this before
 * enabling it.
 *
 * The idea was sound on paper: DHCP is the slowest and least predictable part of a cycle
 * on a board that rejoins every minute — measured leases of 2.0s, 2.5s, 11.3s and 13.1s,
 * and two of six cycles losing the lease entirely. Assigning the address removes that.
 *
 * What happened instead: only the first association after boot could reach anything.
 * Four of the next five cycles failed their upload with ESP_ERR_HTTP_CONNECT, against
 * zero failures across a full DHCP run. The access point is a mesh that hands a
 * rejoining client to a different node, and without a DHCP exchange to re-establish the
 * binding the new node would not route for the address. On this kind of network the
 * lease is not merely slow — it is the thing that makes the rejoin work.
 *
 * Reverting cost more than enabling it: the router held the unleased address against the
 * board's MAC and refused to lease anything for several minutes afterwards, so the board
 * associated every cycle and got no address at all until that cleared.
 *
 * Two things worth keeping from the attempt. Measure before assuming a static address
 * will help — DHCP was only about 2s of a 7.8s off-channel window here, and the rest is
 * the TLS handshake, which this changes nothing about. And verify the address is free
 * across the whole subnet rather than trusting where the pool is believed to end: the
 * pool here ran well past where it was thought to.
 *
 * Leave all five undefined for ordinary DHCP, which is the default and the tested path. */
/* #define CIELOTRACK_STATIC_IP         "10.0.0.240" */
/* #define CIELOTRACK_STATIC_GATEWAY    "10.0.0.1"   */
/* #define CIELOTRACK_STATIC_NETMASK    "255.255.255.0" */
/* #define CIELOTRACK_STATIC_DNS        "10.0.0.1"   */
/* #define CIELOTRACK_STATIC_DNS_BACKUP "1.1.1.1"    */

/* --- the two-board link -------------------------------------------------------
 *
 * Wiring on a Seeed XIAO ESP32S3 — two wires, the link being one-way (sensor writes,
 * master reads). All on the bottom header:
 *     sensor D9 (GPIO8, TX) -> master D10 (GPIO9, RX)
 *     sensor GND           <-> master GND
 *     master D9 (GPIO8, TX) -> sensor D10 (GPIO9, RX)   optional; unused today
 * Avoid D6/D7: they are GPIO43/44, the UART0 console, and carry the log stream.
 *
 * On the SENSOR (the Wi-Fi board): define CIELOTRACK_SENSOR_ONLY 1. It then needs no
 * network credentials, no device key and no device id at all — it decodes and pushes
 * contacts down the wire. It never associates, never leaves its channel, and never
 * needs a clock.
 *
 * On the MASTER (the BLE board): define the peer's device id and key. The master holds
 * both identities so each transport still reports as its own receiver, which is the
 * entire reason for running two boards.
 *
 * Leave all three undefined and both boards behave exactly as before, each with its own
 * uplink. */
/* #define CIELOTRACK_SENSOR_ONLY       1 */
/* #define CIELOTRACK_PEER_DEVICE_ID    "the-other-board's-uuid" */
/* #define CIELOTRACK_PEER_DEVICE_KEY   "the-other-board's-api-key" */

#endif /* SECRETS_H */
