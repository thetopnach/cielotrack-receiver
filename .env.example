# Where to send detections. Leave as-is to use the hosted service.
CENTRAL_SERVER_URL=https://cielotrack.com

# Your receiver's position, used to work out how close aircraft came. Nothing is
# sent anywhere until you claim the receiver to your own account, and the position
# stays with your account.
BASE_LAT=
BASE_LON=

# Bluetooth adapter. Leave blank to auto-detect; set (hci0, hci1, ...) to pin one.
BLE_INTERFACE=

# Wi-Fi adapter to put into monitor mode. This must NOT be the interface carrying
# your network connection — monitor mode takes it off the network.
WIFI_INTERFACE=wlan1

# Channels to listen on. Remote ID beacons are on channel 6 in practice; a rotating
# scan spends most of its time on channels nothing broadcasts on and misses beacons
# while it's away. Comma-separated if you want to override.
WIFI_CHANNELS=6
