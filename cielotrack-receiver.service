[Unit]
Description=CieloTrack Receiver (BLE + Wi-Fi Remote ID capture)
# network-online rather than network: the tracker registers with the server on start,
# and a half-configured interface makes that fail in ways that look like a bad key.
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
# Adjust both paths if you install somewhere other than /opt/cielotrack-receiver.
WorkingDirectory=/opt/cielotrack-receiver
ExecStart=/usr/bin/python3 -u /opt/cielotrack-receiver/radio_tracker.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- hardening ---
# This runs as root because raw HCI and monitor mode need CAP_NET_RAW and
# CAP_NET_ADMIN, and the helpers it drives (hciconfig, hcitool, hcidump, iw) are not
# capability-aware. What follows bounds what root can reach, so a fault in a frame
# parser cannot become a fault in the rest of the machine.
#
# If you install outside /opt, update ReadWritePaths. An /opt install owned by root
# needs nothing else. Installing under a home directory needs three more changes, and
# getting two of them wrong fails in ways that do not look like permissions at all:
#
#   - drop ProtectHome=yes, or the install directory is not visible to the service;
#   - add CAP_DAC_READ_SEARCH, or root cannot traverse into an owner-only home;
#   - add CAP_DAC_OVERRIDE, or root cannot *create* files in a directory it does not
#     own. This is the one that bites. Capture, decoding and alerting all keep working;
#     what breaks is every write that makes a new file — SQLite in WAL mode creating
#     outbox.db-wal, and the status file's status.json.tmp. Detections then fail to
#     queue with "attempt to write a readonly database" while the heartbeat stays
#     green and radios.problems stays empty. We lost 17 hours of uploads to exactly
#     this before writing it down.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_KILL
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/opt/cielotrack-receiver
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# AF_BLUETOOTH for HCI, AF_PACKET for monitor-mode capture, AF_NETLINK for iw.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET AF_BLUETOOTH

[Install]
WantedBy=multi-user.target
