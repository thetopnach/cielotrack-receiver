[Unit]
Description=CieloTrack Receiver (BLE + Wi-Fi Remote ID capture)
# network-online rather than network: the tracker registers with the server on start,
# and a half-configured interface makes that fail in ways that look like a bad key.
After=network-online.target bluetooth.target
Wants=network-online.target bluetooth.target

[Service]
Type=simple
# Adjust both paths if you install somewhere other than /opt/cielotrack-receiver.
WorkingDirectory=/opt/cielotrack-receiver
ExecStart=/usr/bin/python3 -u /opt/cielotrack-receiver/radio_tracker.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- who this runs as ---
# Not root. Decoding Remote ID means parsing frames from anyone within radio range, in
# a process that used to be able to do anything on the machine; the two things it
# actually needs are a raw socket and the ability to configure an interface, and those
# are grantable on their own.
#
# The user is created by provision.sh. AmbientCapabilities is what makes this work
# where a plain unprivileged user would not: the capabilities are in the process's
# *effective* set from the first instruction, so hciconfig, hcitool, hcidump and iw
# behave exactly as they did under root. radio_tracker checks for CAP_NET_RAW rather
# than for uid 0 before deciding whether to reach for sudo — keyed on the wrong one it
# would prepend sudo to every helper call, which fails twice over here: no sudoers
# entry, and NoNewPrivileges blocks the setuid bit sudo needs.
User=cielotrack
Group=cielotrack
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes

# --- where its own data lives ---
# /var/lib/cielotrack, created and chowned by systemd. Not the install directory: the
# updater runs as root and owns the checkout, so a service user could read the code but
# never create a file beside it — and the writes that fail first are the ones that make
# new files, outbox.db-wal and status.json.tmp. Capture keeps working while every
# detection fails to queue, which is the 2026-08-15 outage exactly.
#
# Existing installs must move their data across before taking this unit; migrate_state.py
# does it, and update.sh refuses the release until it has been done.
StateDirectory=cielotrack
StateDirectoryMode=0750

# --- what it can reach ---
# ProtectHome=yes is why /opt is the documented install location. Installing under a
# home directory now needs that dropped *and* the checkout readable by the cielotrack
# user, which means opening up a directory that is 0700 for good reasons. Put it in
# /opt.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
# AF_BLUETOOTH for HCI, AF_PACKET for monitor-mode capture, AF_NETLINK for iw.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET AF_BLUETOOTH

[Install]
WantedBy=multi-user.target
